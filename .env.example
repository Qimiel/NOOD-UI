# NOOD frontend environment template
# Copy to .env (or .env.local) and fill in values. Vite only exposes vars prefixed VITE_.

# Backend API base URL. In dev, leave blank to use the Vite proxy at /api.
VITE_API_URL=

# Toggle dev-only UI (Tweaks panel, dev pill). Set to "true" to show.
VITE_DEV_MODE=false

# ── Firebase Auth ───────────────────────────────────────────────────
# Public values from the Firebase console (Project settings → Web app).
# These ship in the bundle and are NOT secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
